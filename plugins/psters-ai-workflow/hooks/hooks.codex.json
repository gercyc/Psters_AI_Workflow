{
  "description": "psters-ai-workflow hooks for Codex. All entries route through dispatcher.mjs; toggle individual hooks in hooks/config.json.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/dispatcher.mjs\" commit-convention-reminder codex",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/dispatcher.mjs\" track-edit codex",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/dispatcher.mjs\" migration-atomic-reminder codex",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/dispatcher.mjs\" doc-guard-stop codex",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
